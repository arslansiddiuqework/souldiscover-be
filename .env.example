# ==========================================
# AuraPulse Backend — Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# =========================
# SERVER
# =========================
# Match soul-discover-fe defaults (BACKEND_API_URL / NEXT_PUBLIC_API_URL → :4001)
PORT=4001
NODE_ENV=development

# =========================
# OPENROUTER AI (free models only)
# =========================
# Create a key at https://openrouter.ai/keys — keep it server-side only.
OPENROUTER_API_KEY=
# Prefer openrouter/free — the app maps this to curated free *chat* models
# (not content-safety classifiers). Do NOT set paid model IDs.
OPENROUTER_MODEL=openrouter/free
# Optional attribution headers for OpenRouter rankings
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Soul Discovery
# App-level global daily cap (UTC day). Aligns with OpenRouter free-tier ~50/day.
AI_GLOBAL_DAILY_LIMIT=50
# Optional: set true to use an extra OpenRouter call for emotion JSON (burns free quota).
EMOTION_AI_LLM=false

# =========================
# JWT
# =========================
JWT_SECRET=
# Optional dedicated secret for admin JWTs (falls back to JWT_SECRET).
ADMIN_JWT_SECRET=
# Admin access token lifetime (default 8h).
ADMIN_JWT_TTL=8h
# Soft-enforce MFA for superAdmin (warns / flags; does not lock out without enrollment).
ADMIN_MFA_ENFORCE=false
ADMIN_MFA_ISSUER=Soul Discovery Admin

# =========================
# GOOGLE OAUTH
# =========================
# Same Web Client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend.
# Required when the client sends a Google ID token (JWT).
# Access-token (userinfo) login still works without this, but set it in production.
GOOGLE_CLIENT_ID=
# Optional — from the Google Cloud client secret JSON (never commit real values).
GOOGLE_CLIENT_SECRET=

# =========================
# DATABASE
# =========================
# Local: mongodb://localhost:27017/aurapulse
# Vercel: MUST be MongoDB Atlas (localhost will not work on serverless).
# Atlas → Network Access → allow 0.0.0.0/0 (or Vercel IPs), then paste the URI here / in Vercel env.
MONGODB_URI=

# =========================
# EMAIL (Password Reset)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# =========================
# CLOUDINARY (Profile images)
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# TEXTBEE (Emergency SMS)
# =========================
# Server-only secrets — never expose via NEXT_PUBLIC_* or frontend bundles.
# Dashboard / API key: https://textbee.dev (verified account required)
# Requires a registered Android 7+ device with SIM, SMS permissions, and internet.
# Voice calling is NOT supported by TextBee.
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Optional public base URL for this API (non-Twilio uses)
BASE_URL=https://your-backend.example.com

# =========================
# CRISIS SYSTEM
# =========================
CRISIS_ESCALATION_ENABLED=true
CRISIS_COOLDOWN_HOURS=6
MAX_ESCALATIONS_PER_DAY=3
CRISIS_HIGH_THRESHOLD=0.75
CRISIS_CRITICAL_THRESHOLD=0.90
ENABLE_CRISIS_LOGS=true

# =========================
# FREESOUND (Relaxation Music Library)
# =========================
# Token auth — server only. Never expose to the frontend.
# Apply: https://freesound.org/apiv2/apply
# Docs: https://freesound.org/docs/api/
# Limits: 60 req/min, 2000 req/day (standard)
FREESOUND_API_KEY=

# Optional Spotify (existing mood playlists)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
