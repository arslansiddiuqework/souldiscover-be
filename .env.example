# ==========================================
# AuraPulse Backend — Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# =========================
# SERVER
# =========================
PORT=3001
NODE_ENV=development

# =========================
# GROQ AI
# =========================
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# =========================
# JWT
# =========================
JWT_SECRET=

# =========================
# DATABASE
# =========================
MONGODB_URI=

# =========================
# EMAIL (Password Reset)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# =========================
# CLOUDINARY (Profile images)
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# TWILIO (Emergency Calls)
# =========================
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public HTTPS URL Twilio uses to hit your webhooks
# Local dev: install ngrok → ngrok http 3001 → paste the https URL here
# Production: your deployed backend URL (e.g. https://your-app.railway.app)
BASE_URL=https://your-ngrok-url.ngrok.io

# =========================
# CRISIS SYSTEM
# =========================
CRISIS_ESCALATION_ENABLED=true
CRISIS_COOLDOWN_HOURS=6
MAX_ESCALATIONS_PER_DAY=3
CRISIS_HIGH_THRESHOLD=0.75
CRISIS_CRITICAL_THRESHOLD=0.90
ENABLE_CRISIS_LOGS=true
